# SAQ QURYLYS: development configuration. Copy to .env (never commit .env).
# All values below are dev-only placeholders; use real secrets in production.

# --- PostgreSQL (compose `db` service, published on host port 5433) ---
POSTGRES_USER=saq
POSTGRES_PASSWORD=saq_dev_password
POSTGRES_DB=saq
# For running the backend on the host (uv run ...). Compose overrides hosts for containers.
DATABASE_URL=postgresql+psycopg://saq:saq_dev_password@localhost:5433/saq

# --- Redis (Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 (evidence storage with Object Lock) ---
# S3_ENDPOINT is a URL; compose overrides it with http://minio:9000 for containers.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=saq-minio-dev
S3_SECRET_KEY=saq-minio-dev-secret
S3_BUCKET_EVIDENCE=evidence
# GOVERNANCE/1 day in dev; COMPLIANCE/1825 days in production.
EVIDENCE_LOCK_MODE=GOVERNANCE
EVIDENCE_RETENTION_DAYS=1
# RFC 3161 timestamp authority URL; empty = disabled. Only the sha256 digest is sent.
TSA_URL=

# --- Auth ---
# Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
JWT_TTL_MINUTES=480

# --- LLM (Ollama runs on the host: `ollama serve`) ---
LLM_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:9b-q6k
LLM_TIMEOUT_S=120

# --- SMTP (optional; empty host = e-mail disabled) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Web ---
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_MB=25

# --- SAQ VISION (docs/SAQ_VISION_ARCHITECTURE.md) ---
# Off by default: while off, no /api/v1/vision routes exist and the "vision" bucket is never created.
VISION_ENABLED=false
S3_BUCKET_VISION=vision
VISION_MAX_PHOTO_MB=25
VISION_MAX_VIDEO_MB=1024
VISION_MAX_DURATION_SECONDS=1800
# One frame every N seconds of video, at most VISION_MAX_FRAMES frames per video.
VISION_FRAME_INTERVAL_SECONDS=3
VISION_MAX_FRAMES=400
# Object detector: only "disabled" exists for now; findings are created by people.
VISION_DETECTOR_BACKEND=disabled

# --- Housing portal registry sync (daily 03:00 UTC) ---
# Off by default: regular use of api.homeportal.kz needs the agreement of АО «КЖК» (docs/OPEN_QUESTIONS.md, item 11).
# An administrator can still run it by hand: POST /api/v1/registry-sync/homeportal.
HOMEPORTAL_SYNC_ENABLED=false

# --- Automatic collection of publications (docs/SPEC.md §10.1) ---
# Every collector is off by default: enable only sources whose rules you have checked (docs/OPEN_QUESTIONS.md, 30).
COLLECT_TELEGRAM_ENABLED=false
COLLECT_OLX_ENABLED=false
COLLECT_KRISHA_ENABLED=false
# Instagram only through the official Graph API (Business Discovery); empty token = off. Setup: docs/DATA_SOURCES.md.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_GRAPH_USER_ID=
INSTAGRAM_GRAPH_API_VERSION=v26.0
# OLX and Krisha answer a non-browser client with a WAF block (docs/OPEN_QUESTIONS.md, 36 and 40): for a demo set
# COLLECT_USER_AGENT to a regular browser User-Agent and COLLECT_REQUEST_DELAY_S to 5-10.
COLLECT_REQUEST_DELAY_S=2
COLLECT_MAX_PAGES=3

# --- Telegram userbot (docker compose --profile userbot up -d userbot); empty id/hash = off ---
# Get api_id and api_hash at https://my.telegram.org -> API development tools (log in with the userbot's phone
# number). Use a separate number, not a personal one. Needs COLLECT_TELEGRAM_ENABLED=true; then it replaces the
# t.me/s collector. First log in once by QR code (docs/SPEC.md 10.8).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USERBOT_SESSION=/data/userbot/saq
# Pause between joins of new sources (seconds) and messages read per source on the first sync.
USERBOT_JOIN_DELAY_S=60
USERBOT_BACKFILL_LIMIT=100

# --- OCR of photos (Tesseract in the worker image; local, nothing is sent out) ---
OCR_ENABLED=true
OCR_LANGUAGES=rus+kaz+eng

# --- Telegram bot for citizens (docker compose --profile bot up -d); empty token = off ---
TELEGRAM_BOT_TOKEN=
BOT_REPORTS_PER_HOUR=10

# --- Seed (python -m app.seed) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin-password
# Password for demo users created by `python -m app.seed --demo` (dev-only placeholder); empty = random, printed once.
DEMO_USER_PASSWORD=demo-saq-2026
